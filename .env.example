# Django Security & Host Settings
SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# AI API Key (OpenAI or Groq)
# Set your OpenAI API Key (sk-...) or Groq API Key (gsk_...)
OPENAI_API_KEY=your_api_key_here

# Daily AI Action Limit per user (default: 25)
DAILY_AI_LIMIT=25

# Optional Support / Donation Link (shown on profile page)
SUPPORT_URL=

# Optional Contact Email
CONTACT_EMAIL=
